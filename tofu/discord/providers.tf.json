{
  "terraform": {
    "backend": {
      "s3": {
        "bucket": "tofu-state",
        "endpoints": {
          "s3": "https://s3.scottylabs.org"
        },
        "key": "governance/discord.tfstate",
        "region": "us-east-1",
        "skip_credentials_validation": true,
        "skip_metadata_api_check": true,
        "skip_region_validation": true,
        "skip_requesting_account_id": true,
        "use_path_style": true
      }
    },
    "required_providers": {
      "discord": {
        "source": "Lucky3028/discord",
        "version": "~> 2.0"
      },
      "external": {
        "source": "hashicorp/external",
        "version": "~> 2.0"
      }
    }
  },
  "provider": {
    "discord": {
      "token": "${var.discord_token}"
    }
  },
  "variable": {
    "discord_token": {
      "sensitive": true,
      "type": "string"
    }
  }
}